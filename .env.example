# Copy to .env and fill in. Never commit .env.
PERPLEXITY_API_KEY=pplx-your-key-here

# Supabase project URL; tokens are verified against its public JWKS endpoint. Not a secret.
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key. Public client key, not a secret. Used for /api/products and scripts/get-token.mjs.
SUPABASE_ANON_KEY=sb_publishable_...

# Service key. SECRET: it bypasses row-level security, so anyone holding it can read and change
# every table. Used only for scheduled searches: creating and cancelling jobs, which users cannot
# write themselves, and running them for users who are not signed in at the time. Without it,
# jobs can neither be created nor run. Prefer a new secret key made for this backend in Project
# Settings > API Keys, since it can be revoked on its own; the legacy service_role key (eyJ...)
# also works.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Job emails go out through Resend (https://resend.com). EMAIL_FROM must be on a domain verified there.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Leads <leads@yourdomain.com>

# Comma-separated browser origins allowed to call the API. Empty allows any origin.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Optional overrides
# RATE_LIMIT_PER_MINUTE=20
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# PERPLEXITY_TIMEOUT_MS=60000
# Spacing between Perplexity calls, in milliseconds. The rate limit is per account, so calls are
# queued and released one at a time. 1200 suits the lowest tier's 50 requests a minute; 0 disables it.
# PERPLEXITY_MIN_INTERVAL_MS=1200
# A call that would wait longer than this for its turn fails with 429 instead of hanging.
# PERPLEXITY_MAX_QUEUE_WAIT_MS=30000
# Scheduled searches run daily at this UTC hour (0-23, default 3), so users know when the email
# arrives and the searches land off-peak.
# SEARCH_JOBS_RUN_AT_HOUR=3
# Set to false to stop the server running jobs itself, for deployments that trigger
# `npm run jobs` from an external scheduler instead.
# SEARCH_JOBS_ENABLED=true
# SEARCH_JOBS_MAX_ACTIVE_PER_USER=5
# PORT=3000
