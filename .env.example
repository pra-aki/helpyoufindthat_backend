# Copy to .env and fill in. Never commit .env.
PERPLEXITY_API_KEY=pplx-your-key-here

# Supabase project URL; tokens are verified against its public JWKS endpoint. Not a secret.
SUPABASE_URL=https://your-project-ref.supabase.co

# Only needed by scripts/get-token.mjs (local testing). Public client key, not a secret.
# SUPABASE_ANON_KEY=sb_publishable_...

# Comma-separated browser origins allowed to call the API. Empty allows any origin.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Optional overrides
# RATE_LIMIT_PER_MINUTE=20
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_BASE_URL=https://api.perplexity.ai
# PERPLEXITY_TIMEOUT_MS=60000
# PORT=3000
